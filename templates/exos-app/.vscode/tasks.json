{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cmake: build",
			"type": "cmake",
			"command": "build",
			"preset": "${command:cmake.activeBuildPresetName}",
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "run my_app",
			"type": "shell",
			"command": "${command:cmake.launchTargetPath}",
			"dependsOn": "cmake: build",
			"problemMatcher": []
		}
	]
}
